# Copy to .env for Docker Compose. Fill all four required values below.
# Generate independent passwords/secrets, e.g. openssl rand -hex 32.
# Use a URL-safe PostgreSQL password (hex is suitable) for the generated DATABASE_URL.
POSTGRES_PASSWORD=
SITE_ADMIN_EMAIL=
# At least 12 characters; quote values containing $ or # with single quotes.
SITE_ADMIN_PASSWORD=
# Independently generated signing secret, at least 32 bytes.
SITE_ADMIN_SESSION_SECRET=

# Compose serves HTTPS here; use your real hostname for a public deployment.
SITE_ADDRESS=localhost
# Public values are baked into the image; rebuild after changing them.
NEXT_PUBLIC_SITE_URL=https://localhost
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/Deine_Deutsch_Quiz_bot
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/doechkurse
NEXT_PUBLIC_DEUTSCH_TRAINER_BOT_URL=https://t.me/Trainer1512_bot
NEXT_PUBLIC_CONTACT_EMAIL=info@deutschmit.de

# Server-only. Compose derives this from POSTGRES_PASSWORD and the site DB by default.
# For npm or an independently managed PostgreSQL database, set a complete URL and
# apply both db/migrations/*.sql files before accepting traffic.
# Example: postgresql://site_user:URL_ENCODED_PASSWORD@localhost:5432/deutschmit_site
DATABASE_URL=

# Optional Quiz Arena public statistics. Blank disables the integration.
# API_INTERNAL_URL is runtime-only; prefer it over the legacy public build-time fallback.
API_INTERNAL_URL=
NEXT_PUBLIC_API_URL=

# Optional Quiz Bank teaser (all four required only to enable the integration).
# These are server-only runtime values, never Docker build arguments.
QUIZ_BANK_API_BASE_URL=
QUIZ_BANK_EDGE_API_KEY=
QUIZ_BANK_CONSUMER_ID=
QUIZ_BANK_CONSUMER_API_KEY=
