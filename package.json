{
  "name": "deutsch-ist-einfach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:articles": "node scripts/generate-article-server-content.mjs",
    "lint": "eslint . --ext .js,.mjs,.cjs,.jsx,.ts,.mts,.cts,.tsx",
    "test": "vitest run",
    "test:analytics-seo": "vitest run app/(public)/analytics-provider.test.tsx app/(public)/public-home-analytics.test.tsx app/(public)/seo-contracts.test.ts app/(public)/accessibility-behavior.test.tsx",
    "typecheck": "tsc --noEmit",
    "analytics:build": "npm --prefix services/analytics run build",
    "analytics:migrate": "npm --prefix services/analytics run migrate",
    "analytics:cleanup": "npm --prefix services/analytics run cleanup",
    "analytics:delete-visitor": "npm --prefix services/analytics run delete-visitor --",
    "ci": "npm run lint && npm test && npm run typecheck && npm run build && npm run analytics:build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@tanstack/react-query": "^5.56.2",
    "next": "15.5.15",
    "postgres": "^3.4.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.15.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.15",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^4.1.4"
  }
}
